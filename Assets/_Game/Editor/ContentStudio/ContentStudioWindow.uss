.content-studio {
    flex-grow: 1;
    background-color: #202226;
}

.content-toolbar {
    min-height: 28px;
}

#race-filter,
#tier-filter,
#status-filter {
    min-width: 105px;
    max-width: 150px;
}

.toolbar-spacer {
    flex-grow: 1;
}

.content-split {
    flex-grow: 1;
    margin-top: 4px;
}

#content-list {
    min-width: 240px;
}

#details {
    padding: 8px 12px;
}

.identity-block {
    margin-bottom: 8px;
    padding: 8px;
    background-color: #2d3036;
    border-left-width: 3px;
    border-left-color: #55a7d9;
}

.stable-id {
    margin-top: 3px;
    color: #a8d8f5;
    -unity-font-style: bold;
}

.validation-output {
    min-height: 52px;
    max-height: 150px;
    padding: 8px 10px;
    white-space: normal;
    background-color: #17191c;
    border-top-width: 1px;
    border-top-color: #3d4148;
}

.validation-issue {
    margin-bottom: 4px;
    padding: 4px 6px;
    white-space: normal;
    border-left-width: 3px;
}

.validation-info {
    border-left-color: #65a8d8;
}

.validation-warning {
    border-left-color: #d9a441;
}

.validation-error {
    border-left-color: #db6a5c;
}

.validation-critical {
    border-left-color: #ee3d4a;
    -unity-font-style: bold;
}

.unit-section {
    margin-bottom: 6px;
    padding: 4px 6px;
    background-color: #26292e;
}

.disabled-content {
    opacity: 0.55;
}
